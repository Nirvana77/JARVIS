#!/usr/bin/env bash
# Run JARVIS with the repo's own virtualenv, from any directory / any shell.
#
#   ./jarvis-run                # the voice loop
#   ./jarvis-run mic            # mic level meter
#   ./jarvis-run --debug        # verbose + barge-in trace
#   ./jarvis-run --selftest
#
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

py="$here/.venv/bin/python"
if [ ! -x "$py" ]; then
    echo "warning: $here/.venv not found — falling back to system python" >&2
    py="$(command -v python3 || command -v python)"
fi

cd "$here"                      # config.toml / intents.json resolve from here
exec "$py" -m jarvis "$@"
